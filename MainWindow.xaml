<Window x:Class="LabWork4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabWork4"
        mc:Ignorable="d"
        Title="Чудо Обувь — Каталог товаров" Height="720" Width="1000"
        WindowStartupLocation="CenterScreen"
        FontFamily="Calibri" FontSize="14" Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка: логотип, заголовок, ФИО справа -->
        <Grid Grid.Row="0" Background="{StaticResource ExtraBg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Source="/Resources/logo.png" Height="50" Margin="10" Stretch="Uniform"/>
            <TextBlock Grid.Column="1" Text="Каталог товаров" FontSize="24" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="10,0"/>
            <TextBlock x:Name="FioText" Grid.Column="2" FontSize="16"
                       VerticalAlignment="Center" Margin="10,0,16,0"/>
        </Grid>

        <!-- Поиск, сортировка, фильтр, кнопки -->
        <DockPanel Grid.Row="1" Margin="10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CartButton" Content="Корзина" Style="{StaticResource AccentButton}" Click="CartButton_Click"/>
                <Button x:Name="OrdersButton" Content="Заказы" Style="{StaticResource AccentButton}" Click="OrdersButton_Click"/>
                <Button Content="Выход" Click="LogoutButton_Click"/>
            </StackPanel>
            <StackPanel x:Name="FilterPanel" Orientation="Horizontal">
                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="SearchBox" Width="200" Padding="4" TextChanged="Filter_Changed"/>
                <ComboBox x:Name="SortBox" Width="180" Margin="10,0,0,0" SelectionChanged="Filter_Changed"/>
                <ComboBox x:Name="CategoryBox" Width="180" Margin="10,0,0,0" SelectionChanged="Filter_Changed"/>
            </StackPanel>
        </DockPanel>

        <!-- Список товаров -->
        <ListBox x:Name="ProductList" Grid.Row="2" Margin="10,0,10,10"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="ProductList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Card" BorderBrush="Black" BorderThickness="1" Padding="8" Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="{Binding Image}" Width="130" Height="100" Stretch="Uniform"/>
                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock Text="{Binding Title}" FontSize="18" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Category, StringFormat=Категория: {0}}" FontSize="15"/>
                                <TextBlock Text="{Binding QuantityText, StringFormat=Количество: {0}}" FontSize="14"/>
                                <TextBlock Text="{Binding Composition, StringFormat=Состав: {0}}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding FinalPrice, StringFormat={}{0:N2} руб.}"
                                       FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="#ff8080"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0,0,0,6"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </Grid>
</Window>

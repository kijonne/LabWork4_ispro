<Window x:Class="LabWork4.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabWork4"
        mc:Ignorable="d"
        Title="Чудо Обувь — Список заказов" Height="500" Width="760"
        WindowStartupLocation="CenterOwner"
        FontFamily="Calibri" FontSize="14" Background="White">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Заказы" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>

        <DataGrid x:Name="OrdersGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата заказа" Binding="{Binding DateText}" Width="180"/>
                <DataGridTextColumn Header="ФИО клиента" Binding="{Binding ClientFio}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <WrapPanel Grid.Row="2" Margin="0,10,0,0">
            <Button Content="Добавить заказ" Style="{StaticResource AccentButton}" Click="AddButton_Click"/>
            <Button Content="Состав заказа" Click="DetailsButton_Click"/>
            <Button x:Name="EditButton" Content="Редактировать" Click="EditButton_Click"/>
            <Button Content="Удалить" Click="DeleteButton_Click"/>
            <Button Content="Назад" Click="BackButton_Click"/>
        </WrapPanel>
    </Grid>
</Window>

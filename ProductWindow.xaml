<Window x:Class="LabWork4.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabWork4"
        mc:Ignorable="d"
        Title="Чудо Обувь — Просмотр товара" Height="520" Width="760"
        WindowStartupLocation="CenterOwner"
        FontFamily="Calibri" FontSize="14" Background="White">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image x:Name="ProductImage" Grid.Column="0" VerticalAlignment="Top" Height="220" Stretch="Uniform"/>

        <StackPanel Grid.Column="1" Margin="16,0,0,0">
            <TextBlock x:Name="NameText" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock x:Name="ManufacturerText" Margin="0,6,0,0"/>
            <TextBlock x:Name="CategoryText"/>
            <TextBlock x:Name="PriceText" FontSize="18" Margin="0,6,0,6"/>
            <TextBlock x:Name="CompositionText" TextWrapping="Wrap"/>
            <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <TextBlock x:Name="AllSizesText" Margin="0,6,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="AvailableSizesText" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <TextBlock Text="Размер:" VerticalAlignment="Center"/>
                <ComboBox x:Name="SizeBox" Width="160" Margin="8,0,16,0" DisplayMemberPath="Display"/>
                <TextBlock Text="Количество:" VerticalAlignment="Center"/>
                <TextBox x:Name="QuantityBox" Width="50" Margin="8,0,0,0" Padding="4" Text="1"
                         PreviewTextInput="QuantityBox_PreviewTextInput"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="Добавить в заказ" Style="{StaticResource AccentButton}" Click="AddButton_Click"/>
                <Button Content="Назад" Click="BackButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
